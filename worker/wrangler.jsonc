{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chatex-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "USAGE",
        "class_name": "Usage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "Usage"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://chatex.tsilva.eu,https://chatex-phi.vercel.app,https://chatex-tsilvas-projects.vercel.app",
    "TRANSCRIPTION_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-live-transcribe",
    "ROOM_MAX_MINUTES": "60",
    "MAX_ROOMS_PER_DAY": "10",
    "TRANSCRIPTION_URL": ""
  },
  "observability": {
    "enabled": false
  },
  "account_id": "83e1ce4a70ea388693e8525a772ccefa",
  "secrets": {
    "required": [
      "OPENAI_API_KEY"
    ]
  }
}

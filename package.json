{
  "name": "chatex-rooms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:rooms": "node scripts/test-rooms.mjs",
    "deploy:backend": "wrangler deploy --config worker/wrangler.jsonc",
    "dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=true wrangler dev --config worker/wrangler.jsonc --env-file /dev/null --port 0 --ip 127.0.0.1 --local",
    "secrets:sync:production": "python3 scripts/infisical/sync_production.py",
    "test:production-sync": "python3 -B -m unittest discover -s scripts/infisical -p test_production_sync.py"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "ws": "8.21.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7 <7.30.1": "7.30.1",
      "sharp": "0.35.5"
    }
  }
}
